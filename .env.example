# ==========================================
# CONFIGURATION DU BOT CREATORS AREA
# ==========================================

# Cookie d'authentification 'creators_area_token' récupéré depuis creatorsarea.fr
CREATORS_AREA_TOKEN=

# Lien de ton portfolio ou GitHub envoyé lors de la candidature
PORTFOLIO_URL=https://github.com/votre-compte/

# Intervalle de vérification en secondes (10 secondes conseillé)
POLL_INTERVAL_SECONDS=10

# Limite d'âge maximale d'une offre en heures (ex: 24 = ignore les offres publiées il y a plus de 24h)
MAX_OFFER_AGE_HOURS=24

# Accepter de postuler aux offres bénévoles (true ou false)
ALLOW_VOLUNTEER=false

# Prix minimum en euros pour postuler (0 = tout accepter y compris sans prix fixe)
MIN_PRICE=0

# URL de Webhook Discord (Optionnel, pour recevoir les alertes sur ton serveur)
DISCORD_WEBHOOK_URL=

# Mode Dry-Run : true pour tester sans postuler réellement, false pour postuler en vrai
DRY_RUN=false

# ==========================================
# VALIDATION IA (OPTIONNELLE)
# ==========================================
# Fournisseur IA : 'none', 'openrouter', 'gemini', 'groq', 'openai'
AI_PROVIDER=none

# Clé API du fournisseur choisi
AI_API_KEY=

# Modèle IA (Exemples gratuits) :
# Pour OpenRouter : google/gemini-2.0-flash-lite:free ou meta-llama/llama-3.3-70b-instruct:free
# Pour Gemini : gemini-2.0-flash
# Pour Groq : llama-3.3-70b-versatile
AI_MODEL=google/gemini-2.0-flash-lite:free
